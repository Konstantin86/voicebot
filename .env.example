# Copy to /etc/voicebot/voicebot.env on the Pi and fill in. Never commit the real file.

# From Azure portal -> your Foundry resource -> Keys and Endpoint
AZURE_VOICELIVE_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/
AZURE_VOICELIVE_API_KEY=

VOICELIVE_MODEL=gpt-realtime-mini
VOICE=marin
# azure_semantic_vad_multilingual or server_vad
TURN_DETECTION=azure_semantic_vad_multilingual
# Pause (ms) after which your turn counts as finished. Higher = fewer cut-offs, slower answers.
TURN_SILENCE_MS=800
# Writes down what you said: used for the reply language, goodbye detection, memory and the logs.
# Empty = off (replies then cannot follow your language turn by turn).
# mai-transcribe (preview) knows English, Ukrainian and Russian but not Belarusian, so it never
# writes your speech down as Belarusian. gpt-4o-mini-transcribe is the older choice.
TRANSCRIBE_MODEL=mai-transcribe

IDLE_TIMEOUT=30
# After a wake word, while nobody has talked to the bot (likely a false wake):
WAKE_IDLE_TIMEOUT=10
MAX_SESSION=900
CONTEXT_FILE=/etc/voicebot/context.md

# Jabra dot button: single press = next voice, double press = switch between these two models.
# OpenAI voices, then Azure HD voices (these read English, Ukrainian and Russian well).
VOICES=marin,cedar,coral,ash,sage,en-US-Ava:DragonHDLatestNeural,en-US-Andrew2:DragonHDLatestNeural,en-US-Emma2:DragonHDLatestNeural,en-US-Ava:DragonHDOmniLatestNeural
VOICELIVE_SMART_MODEL=gpt-realtime

# Cost estimate in the log uses built-in USD prices per 1M tokens for gpt-realtime-mini and gpt-realtime.
# Override any of them like this (model name in capitals, dashes as underscores):
# PRICE_GPT_REALTIME_MINI_AUDIO_IN=10
# PRICE_GPT_REALTIME_MINI_AUDIO_OUT=20
# PRICE_GPT_REALTIME_AUDIO_OUT=64

# Web search (Tavily). Without a key the bot says it has no current information.
TAVILY_API_KEY=
# YouTube Data API v3 key for "play the latest video from <channel>" on the TV (free, ~90 searches a day).
# Without it, TV videos are found with the Tavily web search.
YOUTUBE_API_KEY=
# AUTO.RIA API key (developers.ria.com) for used car search. Empty = no car search.
AUTO_RIA_API_KEY=
# LG TV settings, written by: sudo -u voicebot /opt/voicebot/venv/bin/python -m voicebot.tv_pair <ip> <mac>
#TV_SETTINGS=/var/lib/voicebot/tv.json
# Films on the disk plugged into the TV: list made by deploy/index_films.sh, and where the TV mounts the disk.
#TV_FILMS_INDEX=/var/lib/voicebot/films.tsv
#TV_MEDIA_ROOT=/tmp/usb/sda/sda2
SEARCH_DAILY_LIMIT=50
# Ranks sites from this country higher (Tavily country name, lowercase). Empty = no preference.
SEARCH_COUNTRY=ukraine

# Memory: long-term facts and recent conversations (saved under MEMORY_DIR).
MEMORY_RECENT_HOURS=12
MEMORY_RECENT_TURNS=80
# Long-term memory: conversation summaries searched by meaning (local Qdrant; empty URL turns it off)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Weather home city (English name). Empty = the "Location:" line in context.md; if that is missing
# too, the city is detected once from this connection's IP address (ipinfo.io).
WEATHER_HOME=
WEATHER_DETECT_HOME=true

# Wake word (local, offline). "Hey Jarvis" + Russian/Ukrainian "Привет/Привіт, Джарвис".
# Models: run deploy/fetch_models.sh once. Raise WAKE_THRESHOLD (0-1) if it wakes by mistake.
WAKE_WORD=true
WAKE_THRESHOLD=0.5

# Who is speaking: voiceprints on the Pi ("remember my voice"). Saved in VOICES_FILE (bot-only).
# A voice counts as recognised when its score is at least VOICE_THRESHOLD and VOICE_MARGIN above the next.
VOICE_ID=true
VOICE_THRESHOLD=0.65
VOICE_MARGIN=0.08
#VOICES_FILE=/var/lib/voicebot/voices.json

# Timers, reminders and alarms (list kept here; spoken sentences in a 'reminders' folder next to it)
#REMINDERS_FILE=/var/lib/voicebot/reminders.json
WAKE_PHRASES=привет джарвис
